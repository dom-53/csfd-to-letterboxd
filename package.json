  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs bookmarklet && vite --config vite.site.mjs",
    "lint": "oxlint --deny-warnings src tests scripts vite.site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:extension": "node scripts/build.mjs extension",
    "build:bookmarklet": "node scripts/build.mjs bookmarklet",
    "build:site": "node scripts/build.mjs site",
