    "verify:wikidata": "node scripts/verify-wikidata.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.8",
    "@types/node": "24.19.4",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
